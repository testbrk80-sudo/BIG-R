{
  "name": "big-r",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord orchestration for conservative Luau source protection and official Luau compilation.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build:compiler": "node tools/build-luau.mjs",
    "build": "npm run build:compiler && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --env-file-if-exists=.env --test dist/test/integration.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
