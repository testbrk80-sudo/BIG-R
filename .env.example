# Discord application credentials
DISCORD_TOKEN=
CLIENT_ID=
# Optional: commands are registered to this guild when set (recommended for development).
GUILD_ID=

# Absolute path to the official luau-compile executable, for example:
# LUAU_COMPILER=C:\\tools\\luau\\build\\Release\\luau-compile.exe
LUAU_COMPILER=

# Optional: status embed sent after every successful obfuscation.
# Generate a new webhook if an old URL was ever shared publicly.
DISCORD_STATUS_WEBHOOK_URL=

# Optional Rubis API base URL; defaults to https://api.rubis.app/v2.
RUBIS_API_URL=https://api.rubis.app/v2
